rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite lectura pública de todas las imágenes cargadas (logos, canchas, hero)
    // Restringe la subida/modificación/eliminación únicamente a administradores autenticados
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
