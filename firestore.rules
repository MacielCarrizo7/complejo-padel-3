rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública para la landing page (configuración, canchas, servicios)
    // Escritura restringida únicamente a usuarios administradores autenticados con Firebase Auth
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
